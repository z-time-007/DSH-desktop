{
  "name": "@local/dsh-desktop-experience",
  "version": "0.1.26",
  "private": true,
  "description": "Desktop-focused UI, black-whale pet, local plugin settings, and sanitized static or animated wallpapers for DeepSeek Harness.",
  "type": "module",
  "main": "./src/dsh-plugin.js",
  "dependencies": {
    "sharp": "0.35.3"
  },
  "exports": {
    ".": "./src/dsh-plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "UNLICENSED"
}
