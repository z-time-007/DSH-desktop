{
  "name": "@local/dsh-office-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Document processing plugin for DeepSeek Harness: read and create DOCX / PPTX / XLSX (and plain text) inside the fixed workspace, plus a chat-composer upload button. Zero runtime dependencies.",
  "type": "module",
  "main": "./src/dsh-plugin.js",
  "exports": {
    ".": "./src/dsh-plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "UNLICENSED"
}
